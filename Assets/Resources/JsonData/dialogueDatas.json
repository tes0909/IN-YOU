      "imageSprite": "Director",
      "uiType": "Intro",
      "Action": "Continue",
      "specialAction": "",
      "PortalAction": ""
    },
    {
      "DIdx": 5,
      "characterName": "담",
      "dialogue": "네, 맞아요. 혹시 어디 있는지 아시나요?",
