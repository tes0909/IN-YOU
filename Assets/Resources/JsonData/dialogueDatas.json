      "imageSprite": "Dam",
      "uiType": "Intro",
      "Action": "Continue",
      "specialAction": "",
      "PortalAction": ""
    },
    {
      "DIdx": 10,
      "characterName": "고아원 원장",
      "dialogue": "뭘···. 나라에서 기간이 오늘까지로 정해진 게 너희들에겐 미안할 따름이지.",
      "position": "right",
      "imageSprite": "Director",
      "uiType": "Intro",
      "Action": "Continue",
      "specialAction": "",
      "PortalAction": ""
    },
    {
      "DIdx": 11,
