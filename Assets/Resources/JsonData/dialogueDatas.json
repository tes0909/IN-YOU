      "imageSprite": "Dam",
      "uiType": "Intro",
      "Action": "Start",
      "specialAction": "",
      "PortalAction": ""
    },
    {
      "DIdx": 4,
      "characterName": "고아원 원장",
      "dialogue": "그래, 담이 왔느냐. 경이를 찾고 있나 보구나.",
