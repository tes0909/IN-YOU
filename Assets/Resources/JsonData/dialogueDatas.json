{
  "dialogueDatas": [
    {
      "DIdx": 0,
      "characterName": "경",
      "dialogue": "오랜만이야, 잘 지냈어?",
      "position": "right",
      "imageSprite": "Gyeong_2_3"
    },
    {
      "DIdx": 1,
      "characterName": "담",
      "dialogue": "그럼~ 잘 지냈지.",
      "position": "left",
      "imageSprite": "protagonist_sprite_5"
    },
    {
      "DIdx": 2,
      "characterName": "경",
      "dialogue": "다행이네. 그거 알아? 우리가 거길 나온지 벌써 10년이 흘렀더라.",
      "position": "right",
      "imageSprite": "Gyeong_2_3"
    },
    {
      "DIdx": 3,
      "characterName": "담",
      "dialogue": "벌써? 시간 참 빠르네.",
      "position": "left",
      "imageSprite": "protagonist_sprite_5"
    },
    {
      "DIdx": 4,
      "characterName": "경",
      "dialogue": "그러게 말이야.",
      "position": "right",
      "imageSprite": "Gyeong_2_3"
    },
    {
      "DIdx": 5,
      "characterName": "담",
      "dialogue": "시시콜콜한 이야기나 나누려고 부르진 않았을 것 같고, 또 무슨 자랑거리가 있어 부르셨나 그래.",
      "position": "left",
      "imageSprite": "protagonist_sprite_5"
    },
    {
      "DIdx": 6,
      "characterName": "경",
      "dialogue": "하여튼 눈치가 빨라요. 나 결혼할 것 같은 사람이 생겼어.",
      "position": "right",
      "imageSprite": "Gyeong_2_3"
    },
    {
      "DIdx": 7,
      "characterName": "담",
      "dialogue": "너를 구제해 줄 사람이 생겼단 말이야? 어디 봐봐.",
      "position": "left",
      "imageSprite": "protagonist_sprite_5"
    },
    {
      "DIdx": 8,
      "characterName": "경",
      "dialogue": "구제는 무슨···. 자, 이 사람이야.",
      "position": "right",
      "imageSprite": "Gyeong_2_3"
    },
    {
      "DIdx": 9,
      "characterName": "담",
      "dialogue": "이쁘시네, 이름이?",
      "position": "left",
      "imageSprite": "protagonist_sprite_5"
    },
    {
      "DIdx": 10,
      "characterName": "경",
      "dialogue": "하나.",
      "position": "right",
      "imageSprite": "Gyeong_2_3"
    },
    {
      "DIdx": 11,
      "characterName": "담",
      "dialogue": "하나···? 꽃? 일본 사람인가?",
      "position": "left",
      "imageSprite": "protagonist_sprite_5"
    },
    {
      "DIdx": 12,
      "characterName": "경",
      "dialogue": "역시···. 담이 넌 일본어랑 친한 것 같아. 영상을 많이 봐서 그런가? ",
      "position": "right",
      "imageSprite": "Gyeong_2_3"
    },
    {
      "DIdx": 13,
      "characterName": "담",
      "dialogue": "···. 그거랑 상관없거든.",
      "position": "left",
      "imageSprite": "protagonist_sprite_5"
    },
    {
      "DIdx": 14,
      "characterName": "경",
      "dialogue": "다음 주에 미국으로 여행을 가려고 해. 다녀와서 소개해줄게.",
      "position": "right",
      "imageSprite": "Gyeong_2_3"
    },
    {
      "DIdx": 15,
      "characterName": "담",
      "dialogue": "다음 주? 보자···. 크리스마스 이브구나? 부럽다~ 잘 다녀와.",
      "position": "left",
      "imageSprite": "protagonist_sprite_5"
    },
    {
      "DIdx": 16,
      "characterName": "경",
      "dialogue": "뭐 갖고 싶은 건 없어? 가다가 보이면 하나쯤 사줄 수도 있는데.",
      "position": "right",
      "imageSprite": "Gyeong_2_3"
    },
    {
      "DIdx": 17,
      "characterName": "담",
      "dialogue": "에이, 됐어. 둘이 잘 놀다 와.",
      "position": "left",
      "imageSprite": "protagonist_sprite_5"
    },
    {
      "DIdx": 18,
      "characterName": "경",
      "dialogue": "나 세 번은 말 안 하는거 알지? 마지막으로 물어볼게. 정말 없어?",
      "position": "right",
      "imageSprite": "Gyeong_2_3"
    },
    {
      "DIdx": 19,
      "characterName": "담",
      "dialogue": "크흠···. 그렇게까지 말한다면야···. 승리의 여신이라는 게임이 있는데 거기서 나오는 한정판 련이가 뉴욕에···.",
      "position": "left",
      "imageSprite": "protagonist_sprite_5"
    },
    {
      "DIdx": 20,
      "characterName": "경",
      "dialogue": "(마무리 멘트 필요)",
      "position": "right",
      "imageSprite": "Gyeong_2_3"
    },
    {
      "DIdx": 21,
      "characterName": "",
      "dialogue": "Next Scene…",
      "position": "left",
      "imageSprite": "protagonist_sprite_5"
    },
    {
      "DIdx": 22,
      "characterName": "Anker",
      "dialogue": "Breaking News",
      "position": "left",
      "imageSprite": "news"
    },
    {
      "DIdx": 23,
      "characterName": "Anker",
      "dialogue": "긴급 속보입니다.",
      "position": "left",
      "imageSprite": "news"
    },
    {
      "DIdx": 24,
      "characterName": "Anker",
      "dialogue": "인천공항을 출발해 미국 뉴욕으로 가던 ㅁㅁ항공 보잉 530이 태평양 한가운데서 폭발을 일으켰습니다.",
      "position": "left",
      "imageSprite": "news"
    },
    {
      "DIdx": 25,
      "characterName": "Anker",
      "dialogue": "현재 미군은 해군과 군용기를 급파해 추적에 나섰습니다.",
      "position": "left",
      "imageSprite": "news"
    },
    {
      "DIdx": 26,
      "characterName": "Anker",
      "dialogue": "12월 24일 오후 8시에 출발한 이 비행기에는 한국인 27명, 일본인 3명, 미국인 17명이 탑승하고 있었으며,",
      "position": "left",
      "imageSprite": "news"
    },
    {
      "DIdx": 27,
      "characterName": "Anker",
      "dialogue": "탑승자 명단은 방송 이후 항공사와 저희 KTN 홈페이지에서 다시 확인할 수 있습니다.",
      "position": "left",
      "imageSprite": "news"
    },
    {
      "DIdx": 28,
      "characterName": "Anker",
      "dialogue": "한국인 탑승자 명단에는 '박수연, 김유민, 이건호... 담...",
      "position": "left",
      "imageSprite": "news"
    },
    {
      "DIdx": 29,
      "characterName": "Letter",
      "dialogue": "나의 유일한 가족이자 친구, 담에게",
      "position": "",
      "imageSprite": ""
    },
    {
      "DIdx": 30,
      "characterName": "Letter",
      "dialogue": "미안해, 담아.",
      "position": "",
      "imageSprite": ""
    },
    {
      "DIdx": 31,
      "characterName": "Letter",
      "dialogue": "죽기 전에야 멀리서 용기를 낸 나를 용서하길 바랄게.",
      "position": "",
      "imageSprite": ""
    },
    {
      "DIdx": 32,
      "characterName": "Letter",
      "dialogue": "이 편지를 읽게 될 즈음이라면...",
      "position": "",
      "imageSprite": ""
    },
    {
      "DIdx": 33,
      "characterName": "Letter",
      "dialogue": "아마 나는 죽었을거야.",
      "position": "",
      "imageSprite": ""
    },
    {
      "DIdx": 34,
      "characterName": "Letter",
      "dialogue": "하루가 채 지나진 않았겠지.",
      "position": "",
      "imageSprite": ""
    },
    {
      "DIdx": 35,
      "characterName": "Letter",
      "dialogue": "너에게 부탁할 것이 하나 있어.",
      "position": "",
      "imageSprite": ""
    },
    {
      "DIdx": 36,
      "characterName": "Letter",
      "dialogue": "우리의 약속을 잊지 않았다면...",
      "position": "",
      "imageSprite": ""
    },
    {
      "DIdx": 37,
      "characterName": "Letter",
      "dialogue": "편지가 발송된 곳으로 찾아와 나의 유서를 읽어주지 않겠어?",
      "position": "",
      "imageSprite": ""
    },
    {
      "DIdx": 38,
      "characterName": "Letter",
      "dialogue": "갑작스레 이런 부탁을 해서 미안해.",
      "position": "",
      "imageSprite": ""
    },
    {
      "DIdx": 39,
      "characterName": "Letter",
      "dialogue": "너 밖에 없더라구.",
      "position": "",
      "imageSprite": ""
    },
    {
      "DIdx": 40,
      "characterName": "Letter",
      "dialogue": " - 경 -",
      "position": "",
      "imageSprite": ""
    },
    {
      "DIdx": 41,
      "characterName": "주박사",
      "dialogue": "반갑습니다. 성함이 '담'님 맞으시죠?",
      "position": "",
      "imageSprite": ""
    },
    {
      "DIdx": 42,
      "characterName": "담",
      "dialogue": "안녕하세요. 제가 맞습니다만... 누구...?",
      "position": "",
      "imageSprite": ""
    },
    {
      "DIdx": 43,
      "characterName": "주박사",
      "dialogue": "저는 ㈜ 리버스에서 일하고 있는 주 박사라고 합니다.",
      "position": "",
      "imageSprite": ""
    },
    {
      "DIdx": 44,
      "characterName": "주박사",
      "dialogue": "경'님의 의뢰를 받아 이곳에서 당신을 기다렸지요.",
      "position": "",
      "imageSprite": ""
    },
    {
      "DIdx": 45,
      "characterName": "담",
      "dialogue": "저를요?",
      "position": "",
      "imageSprite": ""
    },
    {
      "DIdx": 46,
      "characterName": "주박사",
      "dialogue": "네, 당신이 할 일이 있거든요. 여기, 의뢰인의 편지입니다. 읽어보세요.",
      "position": "",
      "imageSprite": ""
    },
    {
      "DIdx": 47,
      "characterName": "편지",
      "dialogue": "잘 왔네. 담아. 다행이야. 잘 왔어...",
      "position": "",
      "imageSprite": ""
    },
    {
      "DIdx": 48,
      "characterName": "편지",
      "dialogue": "여기까지 온 이상 내 말을 들어줄 생각이 있다는 거겠지?",
      "position": "",
      "imageSprite": ""
    },
    {
      "DIdx": 49,
      "characterName": "편지",
      "dialogue": "이곳에 있는 사람들의 도움을 받아서 내 기억을 들여다보면 좋겠어.",
      "position": "",
      "imageSprite": ""
    },
    {
      "DIdx": 50,
      "characterName": "편지",
      "dialogue": "자세한 건 박사님이 설명해 주실 거야.",
      "position": "",
      "imageSprite": ""
    },
    {
      "DIdx": 51,
      "characterName": "담",
      "dialogue": "기억을...들여다본다구요? 이게 무슨···?",
      "position": "",
      "imageSprite": ""
    },
    {
      "DIdx": 52,
      "characterName": "담",
      "dialogue": "설명을 해주실 수 있을까요?",
      "position": "",
      "imageSprite": ""
    },
    {
      "DIdx": 53,
      "characterName": "주박사",
      "dialogue": "그럼요. 물론이죠.",
      "position": "",
      "imageSprite": ""
    },
    {
      "DIdx": 54,
      "characterName": "주박사",
      "dialogue": "저희 제품 중에 [브레인커넥팅] 이라는 기계가 있습니다. ",
      "position": "",
      "imageSprite": ""
    },
    {
      "DIdx": 55,
      "characterName": "주박사",
      "dialogue": "[브레인커넥팅]은 이번에 새로 나온 신제품인데,",
      "position": "",
      "imageSprite": ""
    },
    {
      "DIdx": 56,
      "characterName": "주박사",
      "dialogue": "죽은지 하루가 되지 않은 시체 혹은 뇌사상태에 빠져있는 사람의 머리를 열어",
      "position": "",
      "imageSprite": ""
    },
    {
      "DIdx": 57,
      "characterName": "주박사",
      "dialogue": "제품을 뇌에 직접적으로 연결하면 잠시동안 기억을 엿볼 수 있습니다.",
      "position": "",
      "imageSprite": ""
    },
    {
      "DIdx": 58,
      "characterName": "주박사",
      "dialogue": "유서를 남기지 않았거나, 기억을 보길 원하는 유족에게 도의적으로 제공될 예정이지요.",
      "position": "",
      "imageSprite": ""
    },
    {
      "DIdx": 59,
      "characterName": "주박사",
      "dialogue": "시체 혹은 뇌사상태의 '뇌'가 유족이 원하는 기억을 보여주진 않습니다.",
      "position": "",
      "imageSprite": ""
    },
    {
      "DIdx": 60,
      "characterName": "주박사",
      "dialogue": "지금까지의 테스트로는 뇌가 보여주는 기억은",
      "position": "",
      "imageSprite": ""
    },
    {
      "DIdx": 61,
      "characterName": "주박사",
      "dialogue": "고인이 겪었던 경험 중 강렬했거나 그에 버금가는 어떤 일들이었습니다만, 아직 정확하진 않습니다.",
      "position": "",
      "imageSprite": ""
    },
    {
      "DIdx": 62,
      "characterName": "주박사",
      "dialogue": "게다가 인간의 기억이란 대부분 완벽하지 않기에",
      "position": "",
      "imageSprite": ""
    },
    {
      "DIdx": 63,
      "characterName": "주박사",
      "dialogue": "어떤 부분은 흐릿하게 보이기도 하고, 중간중간 건너뛰어 지기도 합니다.",
      "position": "",
      "imageSprite": ""
    },
    {
      "DIdx": 64,
      "characterName": "주박사",
      "dialogue": "당연한 말이지만 기억을 '보는' 것이기에 어떠한 간섭도 불가능하지요.",
      "position": "",
      "imageSprite": ""
    },
    {
      "DIdx": 65,
      "characterName": "주박사",
      "dialogue": "아, 뇌에 접속할 수 있는 순간은 5분 30초가 최대입니다.",
      "position": "",
      "imageSprite": ""
    },
    {
      "DIdx": 66,
      "characterName": "담",
      "dialogue": "그런 신기술이···.",
      "position": "",
      "imageSprite": ""
    },
    {
      "DIdx": 67,
      "characterName": "주박사",
      "dialogue": "아쉽게도 이 기술은 아직 완벽하지 않습니다. 아니면 신체의 한계...일지도 모르지만요.",
      "position": "",
      "imageSprite": ""
    },
    {
      "DIdx": 68,
      "characterName": "주박사",
      "dialogue": "지금 의뢰인께서는 생명유지장치로 간신히 연명하고 계십니다.",
      "position": "",
      "imageSprite": ""
    },
    {
      "DIdx": 69,
      "characterName": "주박사",
      "dialogue": "그마저도 생명유지장치로 연명할 수 있는 의뢰인의 살 날은 ",
      "position": "",
      "imageSprite": ""
    },
    {
      "DIdx": 70,
      "characterName": "주박사",
      "dialogue": "길어야 오늘... 이라는 것이 이곳에서 도와주시는 세 분의 의사들이 내린 판단이지요.",
      "position": "",
      "imageSprite": ""
    },
    {
      "DIdx": 71,
      "characterName": "주박사",
      "dialogue": "그래서 의뢰를 받아들일 수 있었습니다.",
      "position": "",
      "imageSprite": ""
    },
    {
      "DIdx": 72,
      "characterName": "담",
      "dialogue": "...",
      "position": "",
      "imageSprite": ""
    },
    {
      "DIdx": 73,
      "characterName": "주박사",
      "dialogue": "브레인커넥팅은 전기적인 충격을 가해 뇌에 과부하를 겁니다.",
      "position": "",
      "imageSprite": ""
    },
    {
      "DIdx": 74,
      "characterName": "주박사",
      "dialogue": "그 때문에 일시적으로 뇌가 활성화되지만···.",
      "position": "",
      "imageSprite": ""
    },
    {
      "DIdx": 75,
      "characterName": "주박사",
      "dialogue": "뇌는 이를 받아들이지 못하고 전기충격을 막기 위해 모든 신경계를 스스로 차단합니다.",
      "position": "",
      "imageSprite": ""
    },
    {
      "DIdx": 76,
      "characterName": "주박사",
      "dialogue": "이 과정이 끝나면 확실하게 죽는다는 뜻이죠.",
      "position": "",
      "imageSprite": ""
    },
    {
      "DIdx": 77,
      "characterName": "주박사",
      "dialogue": "우리는 뇌에서 나오는 이 전기신호를 영상화하여 당신께 보여드릴 겁니다.",
      "position": "",
      "imageSprite": ""
    },
    {
      "DIdx": 78,
      "characterName": "주박사",
      "dialogue": "다시는 보고 싶어도 못 보는 단 한 번 뿐인 마지막 기억을 말이죠.",
      "position": "",
      "imageSprite": ""
    },
    {
      "DIdx": 79,
      "characterName": "담",
      "dialogue": "이걸 그 친구가 원했다구요?",
      "position": "",
      "imageSprite": ""
    },
    {
      "DIdx": 80,
      "characterName": "주박사",
      "dialogue": "저야 정확한 사정은 모릅니다만, 아마 그러지 않을까 싶긴 합니다.",
      "position": "",
      "imageSprite": ""
    },
    {
      "DIdx": 81,
      "characterName": "주박사",
      "dialogue": "보여주고 싶었던 기억이나 남기고 싶은 말이 있지 않았을까요?",
      "position": "",
      "imageSprite": ""
    },
    {
      "DIdx": 82,
      "characterName": "주박사",
      "dialogue": "저희도 그런 이유로 의뢰하신 것으로 생각하지만, 정확한 이유는 직접 보셔야 아실 겁니다.",
      "position": "",
      "imageSprite": ""
    },
    {
      "DIdx": 83,
      "characterName": "담",
      "dialogue": "…후",
      "position": "",
      "imageSprite": ""
    },
    {
      "DIdx": 84,
      "characterName": "담",
      "dialogue": "…",
      "position": "",
      "imageSprite": ""
