      "imageSprite": "Dam",
      "uiType": "Intro",
      "Action": "Continue",
      "specialAction": "",
      "PortalAction": ""
    },
    {
      "DIdx": 12,
      "characterName": "고아원 원장",
      "dialogue": "그래, 잘 먹고 아프지 말고.",
