      "dialogue": "안녕. 연아~",
      "position": "left",
      "imageSprite": "Dam",
      "uiType": "Intro",
      "Action": "Start",
      "specialAction": "",
      "PortalAction": ""
    },
    {
      "DIdx": 16,
      "characterName": "담",
