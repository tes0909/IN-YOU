  npcName: "\uC124"
  playerName: "\uB2F4"
  playerDialogue:
  - "\uC751 \uB9DE\uC544..\uC544\uC27D\uC9C0\uB9CC \uADF8\uB807\uAC8C \uB410\uC5B4.
    \uD639\uC2DC \uACBD\uC774 \uBABB\uBD24\uC5B4?"
  - "\uC54C\uB824\uC918\uC11C \uACE0\uB9C8\uC6CC. \uADFC\uB370 \uC5EC\uAE30\uC11C
    \uBB50\uD558\uACE0 \uC788\uB294\uAC70\uC57C?"
  - ...
  - "\uADF8\uB798, \uAC00\uBCFC\uAC8C. \uC548\uB155."
  npcDialogue:
  - "\uC548\uB155, \uB108 \uC624\uB298 \uB5A0\uB09C\uB2E4\uBA70?"
  - "\uACBD\uC774? \uC544\uAE4C \uC5EC\uAE30 \uC7A0\uC2DC \uC654\uB2E4\uAC00 \uBC11\uC73C\uB85C
    \uB0B4\uB824\uAC14\uC5B4."
  - "\uCC45\uC744 \uC77D\uB2E4\uAC00 \uB3D9\uC0DD \uC0DD\uAC01\uC774 \uB098\uC11C
    \uC7A0\uC2DC \uB4E4\uB800\uC5B4."
  - "\uAD1C\uCC2E\uC544. \uC2DC\uAC04\uC740 \uB9CE\uC774 \uD758\uB800\uB294\uAC78.
    \uC5B4\uC11C \uAC00\uBD10. "
